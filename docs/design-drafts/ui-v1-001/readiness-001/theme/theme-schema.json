{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design theme closed dialect v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "group",
    "resources"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "themeId",
        "themeVersion",
        "compatibility",
        "baselineSHA",
        "status",
        "source"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "themeId": {
          "type": "string",
          "minLength": 1
        },
        "themeVersion": {
          "type": "string",
          "minLength": 1
        },
        "compatibility": {
          "const": "R2_PRESENTATION_ONLY"
        },
        "baselineSHA": {
          "const": "956da8065030ccea15256e49bd927a4e6a71942f"
        },
        "status": {
          "const": "TEST"
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "group": {
      "enum": [
        "bandage",
        "porter",
        "frame"
      ]
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "pixels",
          "alpha",
          "canvas",
          "foot",
          "hit",
          "motion",
          "nineSlice",
          "fit",
          "path",
          "sha256",
          "format",
          "status",
          "sourceSha256",
          "derivation"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "pixels": {
            "type": [
              "array",
              "null"
            ]
          },
          "alpha": {
            "type": "boolean"
          },
          "canvas": {
            "type": [
              "array",
              "null"
            ]
          },
          "foot": {
            "type": [
              "array",
              "null"
            ]
          },
          "hit": {
            "type": [
              "array",
              "null"
            ]
          },
          "motion": {
            "type": [
              "object",
              "null"
            ]
          },
          "nineSlice": {
            "type": [
              "object",
              "null"
            ]
          },
          "fit": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "format": {
            "const": "SVG"
          },
          "status": {
            "const": "TEST"
          },
          "sourceSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "derivation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$comment": "Structural schema; theme_check additionally enforces full group, exact geometry, safe SVG and original embedded PNG. Not art approval."
}
